{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Anya",
  "version": "0.2.10",
  "identifier": "ai.anya.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:13330",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "overlay",
        "title": "Anya",
        "url": "/#/overlay",
        "width": 640,
        "height": 84,
        "minWidth": 640,
        "minHeight": 84,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "center": true,
        "focus": false,
        "resizable": false,
        "maximizable": false
      },
      {
        "label": "workbench",
        "title": "Anya",
        "url": "/#/workbench",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "alwaysOnTop": false,
        "visible": false,
        "skipTaskbar": false,
        "center": true,
        "focus": true,
        "resizable": true,
        "maximizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPCACHE/image-preview/**", "$APPCACHE/icons/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdBMTE5MTc3MDBERjBFRDQKUldUVUR0OEFkNUVSZXJ3Rm8rNnVvLy93c3R3eUhJY2FnMEhGK2pZQzZnWWQ1MDJ0MHdKNjhhN3cK",
      "endpoints": [
        "https://github.com/rururunu/Anya/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
