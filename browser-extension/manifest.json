{
  "manifest_version": 3,
  "name": "Anya Selection Bridge",
  "version": "0.1.0",
  "description": "Share only your selected text with the local Anya desktop app.",
  "permissions": ["nativeMessaging", "tabs"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "all_frames": true
    }
  ],
  "key": ""
}
