{
  "id": "delete_via_overwrite",
  "prompt": "Clear trash.txt to empty.",
  "setupFiles": [
    {
      "path": "trash.txt",
      "content": "old"
    }
  ],
  "script": [
    {
      "content": "",
      "tool_calls": [
        {
          "name": "write_file",
          "arguments": {
            "path": "trash.txt",
            "content": "",
            "allow_overwrite": true
          }
        }
      ]
    },
    {
      "content": "",
      "tool_calls": [
        {
          "name": "read_file",
          "arguments": {
            "path": "trash.txt"
          }
        }
      ]
    },
    {
      "content": "任务完成",
      "tool_calls": []
    }
  ],
  "assertions": [
    {
      "type": "fileEquals",
      "path": "trash.txt",
      "text": ""
    },
    {
      "type": "finishReason",
      "reason": "stop"
    }
  ]
}
