{
  "id": "json_config",
  "prompt": "Set package.json name to anya-eval.",
  "setupFiles": [
    {
      "path": "package.json",
      "content": "{\"name\": \"old\", \"scripts\": {\"check\": \"node -e \\\"if(require('./package.json').name !== 'anya-eval') process.exit(1)\\\"\"}}"
    }
  ],
  "script": [
    {
      "content": "",
      "tool_calls": [
        {
          "name": "replace_in_file",
          "arguments": {
            "path": "package.json",
            "old_string": "\"name\": \"old\"",
            "new_string": "\"name\": \"anya-eval\""
          }
        }
      ]
    },
    {
      "content": "",
      "tool_calls": [
        {
          "name": "read_file",
          "arguments": {
            "path": "package.json"
          }
        }
      ]
    },
    {
      "content": "任务完成",
      "tool_calls": []
    }
  ],
  "assertions": [
    {
      "type": "fileContains",
      "path": "package.json",
      "text": "anya-eval"
    },
    {
      "type": "finishReason",
      "reason": "stop"
    }
  ]
}
